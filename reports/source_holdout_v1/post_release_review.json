  "reviewed_initial_commit": "7302f172c360626d593cb030caa2465edc48a213",
  "scope": "Post-publication engineering reliability review using independent synthetic fixtures; no frozen-model rerun, new candidate, reselection, or result replacement.",
  "findings_and_fixes": [
    {
      "area": "metric inputs",
      "finding": "Blank gold text could match an empty context; loose input types/nonfinite values could corrupt denominators.",
      "fix": "Reject empty/noncanonical IDs, duplicate ranks, blank gold chunks, invalid cutoffs, nonfinite values and non-boolean labels; never infer opaque-ID aliases."
    },
    {
      "area": "uncertainty",
      "finding": "One publisher yielded a spuriously precise cluster interval.",
      "fix": "Require at least two clusters and positive integer draw count; retain the warning that two clusters are unstable."
    },
    {
      "area": "versioned generation diagnostics",
      "finding": "Version 2 could drop sentence-final numbers, lose percentage markers, consume prose after an empty SOURCE line, or credit failed requests as refusals.",
      "fix": "Version 3 handles these synthetic boundaries; version 2 remains explicitly selectable for historical parser behavior. Mixed-version arm comparisons are rejected. Published version-2 values are not recomputed."
    },
    {
      "area": "cached source provenance",
      "finding": "A cached success was trusted without rechecking its bytes or publisher assignment.",
      "fix": "Verify body size/SHA and publisher/URL identity; reject escaping artifact paths; preserve orphan snapshots and cached failures."
    },
    {
      "area": "bounded acquisition",
      "finding": "The previous byte limit was checked only after reading the full response.",
      "fix": "Enforce the cap while streaming, close responses, reject duplicate registry URLs and return failure status for failed acquisitions. Unit tests use mocked HTTP only."
    },
    {
      "area": "FAQ extraction",
      "finding": "Conflicting duplicate questions silently kept the first answer; a missing dt answer could borrow the next question answer; a single long token could exceed the chunk cap.",
      "fix": "Record identical duplicates, reject conflicting answers, require adjacent dd, reject oversized tokens, and refuse existing extraction artifacts."
    },
    {
      "area": "sealing and reproduction",
      "finding": "Historical input hash was not bound at seal time; failed preflight could leave an empty sealed directory.",
      "fix": "Add explicit --history-dir, bind its historical strings to the overlap audit hash, and complete preflight before creating the sealed directory. Document exact commands and dependencies."
    },
    {
      "area": "metadata warnings",
      "finding": "Non-string or blank metadata could look like a declared scope; missing publisher was not reported.",
      "fix": "Validate metadata types/IDs and warn for missing publisher/jurisdiction. No default runtime integration or serving action."
    }
  ],
